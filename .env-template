# Copy to .env (local only — never commit .env).
#
# Absolute path to tutorials/ so imports like `pathologies.*` resolve.
PYTHONPATH=/absolute/path/to/qlab/tutorials

# Optional: override pathologies HF caches (train.py defaults to <repo>/.cache/).
# PATHOLOGIES_HF_HOME=/absolute/path/to/qlab/.cache/huggingface
# PATHOLOGIES_HF_HUB_CACHE=/absolute/path/to/qlab/.cache/huggingface/hub
# PATHOLOGIES_HF_DATASETS_CACHE=/absolute/path/to/qlab/.cache/datasets

# Optional: faster Hub downloads.
# HF_TOKEN=

# Weights & Biases (tutorials/pathologies — run.sh sets WANDB_DIR per run)
# WANDB_PROJECT=pathologies
# WANDB_MODE=offline
# WANDB_API_KEY=
# Local W&B server: wandb server start  then uncomment:
# WANDB_BASE_URL=http://localhost:8080
