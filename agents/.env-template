# Copy to agents/.env (local only — never commit .env).
# Single source of truth for Langfuse stack + all agent experiments.
#
# Langfuse stack:
#   cd agents && docker compose -f docker-compose.langfuse.yml up -d
# ReHarness:
#   cd agents && docker compose -f reharness/docker-compose.yml up -d --build

# --- Shared agents Docker image (./build-image.sh) ---
AGENTS_RUNTIME_IMAGE=agents-runtime:latest

# --- LLM (all experiments) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Langfuse tracing (SDK — one project; use AGENT_NAME tag per experiment) ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-dev-key
LANGFUSE_SECRET_KEY=sk-lf-your-dev-key
LANGFUSE_BASE_URL=http://langfuse-web:3000
LANGFUSE_TRACING_ENABLED=true
AGENT_NAME=reharness
# Optional extra tags: LANGFUSE_TAGS=dev,cheong

# --- Langfuse server (Docker stack only) ---
# Host port for Langfuse UI (must match NEXTAUTH_URL)
LANGFUSE_UI_PORT=3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-openssl-rand-hex-32

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:change-me-postgres@postgres:5432/postgres

CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=change-me-clickhouse

REDIS_AUTH=change-me-redis

MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

SALT=change-me-salt
ENCRYPTION_KEY=change-me-openssl-rand-hex-32

# Headless init (first boot only, empty Postgres volume; keys = LANGFUSE_PUBLIC/SECRET above)
LANGFUSE_INIT_ORG_ID=default-org
LANGFUSE_INIT_ORG_NAME=default
LANGFUSE_INIT_PROJECT_ID=agents-project
LANGFUSE_INIT_PROJECT_NAME=agents
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=change-me-admin

# --- Shared agent defaults ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CONTEXT_LIMIT=128000  # for AgentContextManager experiments — not used by ReHarness
# File logs (Docker: reharness compose sets AGENT_LOG_DIR=/logs → reharness/.data/logs/agent.log)
# AGENT_LOG_DIR=
# AGENT_LOG_LEVEL=INFO
# AGENT_LOG_MAX_BYTES=5242880
# AGENT_LOG_BACKUP_COUNT=0

# --- ReHarness experiment ---
REHARNESS_TOP_K=5
AGENT_PORT=8080
QDRANT_URL=http://qdrant:6333
QDRANT_MEMORY_CONFIG=/app/agents/reharness/config/qdrant_memory.json
PYTHON_RUN_TIMEOUT_SECONDS=30
CHECKPOINT_PATH=/data/checkpoints.sqlite

# --- ReHarness UI (Streamlit on host; ./reharness/run-ui.sh) ---
REHARNESS_AGENT_URL=http://localhost:8080
REHARNESS_UI_PORT=8501

# --- HippoRAG experiment (./hipporag/run-agent.sh) ---
HIPPORAG_AGENT_PORT=8081
HIPPORAG_AGENT_URL=http://localhost:8081
# HippoRAG UI (Streamlit on host; ./hipporag/run-ui.sh)
HIPPORAG_UI_PORT=8502
# HIPPORAG_NEO4J_BROWSER_URL=http://localhost:7474
# HIPPORAG_CONFIG=/app/agents/hipporag/config/default.json
# HIPPORAG_PPR_DAMPING=0.5
# HIPPORAG_TOP_K=5
# Default: toy corpus + committed openie.json (no LLM cost). Set HIPPORAG_OPENIE=llm for live OpenIE.
# HIPPORAG_OPENIE=fixture
# HIPPORAG_BOOTSTRAP_TOY=1
# HIPPORAG_GRAPH_BACKEND=neo4j
# Neo4j (hipporag compose — Browser http://localhost:7474, GDS Community via NEO4J_PLUGINS)
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me-neo4j
# HIPPORAG_NEO4J_HTTP_PORT=7474
# HIPPORAG_NEO4J_BOLT_PORT=7687

# --- MemGraphRAG experiment (./memgraphrag/run-agent.sh) ---
MEMGRAPHRAG_AGENT_PORT=8082
MEMGRAPHRAG_AGENT_URL=http://localhost:8082
# MEMGRAPHRAG_CONFIG=/app/agents/memgraphrag/config/default.json
# MEMGRAPHRAG_PPR_DAMPING=0.5
# MEMGRAPHRAG_TOP_K=5
